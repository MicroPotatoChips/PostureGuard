<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mint_canvas"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_leaf" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_name"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="18sp"
                    android:textColor="@color/ink" />
                <TextView style="@style/Posture.Label"
                    android:text="@string/brand_tagline"
                    android:textSize="10sp" />
            </LinearLayout>
            <TextView style="@style/Posture.Label"
                android:text="@string/local_badge"
                android:textColor="@color/mint_primary"
                android:background="@drawable/bg_pill" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/page_title"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink" />
        <TextView style="@style/Posture.Label"
            android:layout_marginTop="8dp"
            android:text="@string/page_subtitle"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btnSide">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSide"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/side_mode"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFront"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/front_mode"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/line"
            app:cardBackgroundColor="@color/mint_light">
            <FrameLayout android:layout_width="match_parent" android:layout_height="264dp">
                <androidx.camera.view.PreviewView
                    android:id="@+id/viewFinder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="invisible"
                    android:background="@color/ink"
                    app:implementationMode="compatible"
                    app:scaleType="fitCenter" />
                <LinearLayout
                    android:id="@+id/previewPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <ImageView
                        android:layout_width="260dp"
                        android:layout_height="160dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/illustration_posture" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_idle"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView style="@style/Posture.Label"
                        android:layout_marginTop="7dp"
                        android:text="@string/preview_idle_hint"
                        android:gravity="center"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvLive"
                    style="@style/Posture.Label"
                    android:layout_gravity="top|start"
                    android:layout_margin="14dp"
                    android:text="@string/ready_badge"
                    android:textColor="@color/mint_primary"
                    android:background="@drawable/bg_pill" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitch"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:minWidth="0dp"
                    android:padding="12dp"
                    android:contentDescription="@string/switch_camera"
                    app:icon="@drawable/ic_switch_camera"
                    app:iconTint="@color/ink"
                    app:iconPadding="0dp"
                    app:cornerRadius="24dp"
                    app:backgroundTint="@color/surface" />
                <TextView
                    android:id="@+id/tvCamera"
                    style="@style/Posture.Label"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:text="@string/camera_front"
                    android:background="@drawable/bg_pill"
                    android:textSize="10sp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/line"
            app:cardBackgroundColor="@color/surface">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:orientation="horizontal">
                <com.postureguard.ScoreRingView
                    android:id="@+id/scoreRing"
                    android:layout_width="82dp"
                    android:layout_height="82dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/status_idle"
                        android:textSize="19sp"
                        android:textColor="@color/ink"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:id="@+id/tvHint"
                        style="@style/Posture.Label"
                        android:layout_width="match_parent"
                        android:layout_marginTop="7dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/hint_idle" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/mint_light">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:orientation="vertical">
                    <TextView android:id="@+id/tvMetricOneLabel" style="@style/Posture.Label"
                        android:text="@string/metric_head_forward" />
                    <TextView android:id="@+id/tvMetricOne" style="@style/Posture.MetricValue"
                        android:text="@string/metric_missing" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/mint_light">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:orientation="vertical">
                    <TextView android:id="@+id/tvMetricTwoLabel" style="@style/Posture.Label"
                        android:text="@string/metric_trunk" />
                    <TextView android:id="@+id/tvMetricTwo" style="@style/Posture.MetricValue"
                        android:text="@string/metric_missing" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvCalibration" style="@style/Posture.Label"
                    android:text="@string/calibration_default" android:textColor="@color/mint_primary" />
                <TextView android:id="@+id/tvSignal" style="@style/Posture.Label"
                    android:layout_marginTop="4dp" android:text="@string/signal_waiting" android:textSize="10sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalibrate"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:enabled="false"
                android:text="@string/calibrate"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/calibrationProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            app:indicatorColor="@color/mint_primary"
            app:trackColor="@color/line"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:layout_marginBottom="14dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Posture.Label" android:text="@string/session_label" />
                <TextView android:id="@+id/tvSession" style="@style/Posture.MetricValue"
                    android:text="00:00" android:textSize="18sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Posture.Label" android:text="@string/good_rate_label" />
                <TextView android:id="@+id/tvGoodRate" style="@style/Posture.MetricValue"
                    android:text="@string/metric_missing" android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/start_monitoring"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:enabled="false"
            app:cornerRadius="18dp" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/sound_on"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:checked="true" />
        <TextView android:id="@+id/tvAlert" style="@style/Posture.Label"
            android:text="@string/alert_caption" android:textSize="11sp" />
        <TextView style="@style/Posture.Label"
            android:layout_marginTop="8dp"
            android:text="@string/score_note" android:textSize="10sp" />
        <TextView style="@style/Posture.Label"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="@string/privacy_caption" android:textSize="10sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
